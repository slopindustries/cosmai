# CosmaSignal credential and local configuration variable names.
#
# This file records NAMES and FORMATS only. It is committed to Git.
# Never put a real credential value here.
#
# Real values live outside the repository working tree, by default in
# ~/.config/cosmasignal/env (mode 600). Load them with:
#
#   ./scripts/with-secrets.sh <command>
#
# Procedure: docs/conventions/secret-setup.md
# Constraint: docs/conventions/p0-security.md

# --- Credentials -------------------------------------------------------------
#
# Naming: COSMA_SRC_<SOURCE_ID>_<PURPOSE>
#
# The `credential_ref` persisted in the database is exactly this variable name.
# The value itself is never stored in a source row, job payload, Raw envelope,
# log, or fixture.
#
# COSMA_SRC_EXAMPLE_TOKEN=<opaque bearer token>
# COSMA_SRC_EXAMPLE_API_KEY=<api key>

# --- Local configuration -----------------------------------------------------
#
# Non-credential local settings may also be recorded here by name.
# If a value embeds a password, treat the whole variable as a credential.
#
# COSMA_DB_URL=postgresql://localhost:5432/cosmasignal
