# Optional convenience for direnv users. Nothing in this repository requires
# direnv or Nix, and this file does nothing until you explicitly run
# `direnv allow`. The uv path in README.md works identically with or without it.

if has nix; then
  use flake
else
  echo "direnv: nix not found; skipping the optional dev shell. The uv path is unaffected." >&2
fi

# Per-user overrides. Never committed, so customising the shell does not dirty
# the working tree.
source_env_if_exists .envrc.local
